{
    "console-log": {
        "prefix": "clog",
        "body": ["console.log(\"$1\")", "$0"],
        "description": "Logs to console"
    },
    "42 Header (SCLS)": {
        "prefix": "stdheader",
        "body": [
            "/* ************************************************************************** */",
            "/*                                                                            */",
            "/*                                                        :::      ::::::::   */",
            "/*   001.c                                              :+:      :+:    :+:   */",
            "/*                                                    +:+ +:+         +:+     */",
            "/*   By: fparola <fabricio.parola@gmail.com>        +#+  +:+       +#+        */",
            "/*                                                +#+#+#+#+#+   +#+           */",
            "/*   Created: 2025/10/23 22:42:00 by fparola           #+#    #+#             */",
            "/*   Updated: 2025/10/23 22:42:00 by fparola          ###   ########.fr       */",
            "/*                                                                            */",
            "/* ************************************************************************** */"
        ]
    },
    "C": {
        "c-main": {
            "prefix": "main",
            "body": [
                "int main(int argc, char *argv[])",
                "{$0",
                "\treturn 0;",
                "}"
            ]
        },
        "pf": {
            "prefix": "pf",
            "body": ["printf(\"$1\");"]
        },
        "pfn": {
            "prefix": "pfn",
            "body": ["printf(\"$1\\n\");"]
        },
        "prd": {
            "prefix": "prd",
            "body": ["printf(\"x0: %d\\n\", $1);"],
            "description": "printf debug integer"
        },
        "prs": {
            "prefix": "prs",
            "body": ["printf(\"x0: %s\\n\", \"$1\");"],
            "description": "printf debug string"
        },
        "prf": {
            "prefix": "prf",
            "body": ["printf(\"x0: %f\\n\", $1);"],
            "description": "printf debug float"
        },
        "prc": {
            "prefix": "prc",
            "body": ["printf(\"x0: %c\\n\", '$1');"],
            "description": "printf debug char"
        },
        "prp": {
            "prefix": "prp",
            "body": ["printf(\"x0: %p\\n\", $1);"],
            "description": "printf debug pointer"
        }
    }
}
